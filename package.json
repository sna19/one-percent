{
	"name": "one-percent",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"backup": "node scripts/backup.mjs",
		"start": "node build",
		"db:generate": "drizzle-kit generate"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/better-sqlite3": "^9.6.0",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.73.0",
		"@tiptap/core": "^3.33.1",
		"@tiptap/extension-highlight": "^3.33.1",
		"@tiptap/extension-list": "^3.33.1",
		"@tiptap/pm": "^3.33.1",
		"@tiptap/starter-kit": "^3.33.1",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"idb-keyval": "^6.3.0"
	}
}
